rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasVisibleProfile(appId, uid) {
      return exists(/databases/$(database)/documents/artifacts/$(appId)/public_profiles/$(uid)) &&
        get(/databases/$(database)/documents/artifacts/$(appId)/public_profiles/$(uid)).data.privacy in ["public", "invite_only"];
    }

    function profilePrivacy(appId, uid) {
      return get(/databases/$(database)/documents/artifacts/$(appId)/public_profiles/$(uid)).data.privacy;
    }

    // Owner-controlled facts about the caller, used to gate reads and follows.
    function isBlockedBy(appId, ownerUid) {
      return exists(/databases/$(database)/documents/artifacts/$(appId)/relationships/$(ownerUid)/blocked/$(request.auth.uid));
    }

    function isAcceptedFollowerOf(appId, ownerUid) {
      return exists(/databases/$(database)/documents/artifacts/$(appId)/relationships/$(ownerUid)/followers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/artifacts/$(appId)/relationships/$(ownerUid)/followers/$(request.auth.uid)).data.status == "following";
    }

    function hasPendingRequestFrom(appId, ownerUid, requesterUid) {
      return exists(/databases/$(database)/documents/artifacts/$(appId)/relationships/$(ownerUid)/requests/$(requesterUid));
    }

    // Who may read someone else's board:
    //  - public boards: any signed-in user the owner hasn't blocked
    //  - invite_only boards: only followers the owner has accepted
    //  - private boards: nobody but the owner
    function canViewBoard(appId, ownerUid) {
      return signedIn() &&
        !isBlockedBy(appId, ownerUid) &&
        hasVisibleProfile(appId, ownerUid) &&
        (
          profilePrivacy(appId, ownerUid) == "public" ||
          (profilePrivacy(appId, ownerUid) == "invite_only" && isAcceptedFollowerOf(appId, ownerUid))
        );
    }

    // An accepted follower, without reading the follow document itself: every
    // followers entry the rules accept has status "following", and blocking
    // deletes the entry on both sides. Two document reads instead of
    // canViewBoard's five, which is what keeps a feed page — one query per
    // friend — affordable.
    function isFollowerOf(appId, ownerUid) {
      return exists(/databases/$(database)/documents/artifacts/$(appId)/relationships/$(ownerUid)/followers/$(request.auth.uid));
    }

    // Same visibility as the board (design decision 4), reached by the cheap
    // path first: a feed page is one query per friend, so this runs once per
    // friend shown.
    function canViewActivity(appId, ownerUid) {
      return signedIn() &&
        !isBlockedBy(appId, ownerUid) &&
        (isFollowerOf(appId, ownerUid) || canViewBoard(appId, ownerUid));
    }

    function validPrivacy(value) {
      return value in ["public", "invite_only", "private"];
    }

    function validPlaylistPrivacy(value) {
      return value in ["public", "private"];
    }

    function validString(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function validOptionalString(data, field, maxLength) {
      return !(field in data) || validString(data[field], maxLength);
    }

    function validOptionalNumber(data, field) {
      return !(field in data) || data[field] is number;
    }

    function validSearchTokens(tokens) {
      return tokens is list &&
        tokens.size() <= 80 &&
        (tokens.size() == 0 || validString(tokens[0], 20)) &&
        (tokens.size() <= 1 || validString(tokens[tokens.size() - 1], 20));
    }

    // Board schema 2: the board document only holds the columns; games live in
    // users/{uid}/games/{gameId} (see validGame*).
    function validBoardV2(data) {
      return data.keys().hasOnly(["columns", "columnOrder", "schemaVersion", "updatedAt"]) &&
        data.schemaVersion == 2 &&
        data.columns is map &&
        data.columnOrder is list &&
        data.columns.keys().size() <= 5 &&
        data.columnOrder.size() <= 5 &&
        data.updatedAt == request.time;
    }

    // TRANSITIONAL (remove in S3's follow-up): schema 1 boards, games embedded
    // in the document. Accepted only while the stored board is not yet on
    // schema 2, so a migrated board can never be downgraded.
    function validLegacyBoard(data) {
      return data.keys().hasOnly(["games", "columns", "columnOrder"]) &&
        data.games is map &&
        data.columns is map &&
        data.columnOrder is list &&
        data.games.keys().size() <= 500 &&
        data.columns.keys().size() <= 5 &&
        data.columnOrder.size() <= 5;
    }

    function storedBoardIsV2() {
      return resource != null && resource.data.get("schemaVersion", 1) == 2;
    }

    function validBoard(data) {
      return validBoardV2(data) ||
        (!storedBoardIsV2() && validLegacyBoard(data));
    }

    function validOptionalInt(data, field, min, max) {
      return !(field in data) || (data[field] is int && data[field] >= min && data[field] <= max);
    }

    function validOptionalBool(data, field) {
      return !(field in data) || data[field] is bool;
    }

    function validOptionalTimestamp(data, field) {
      return !(field in data) || data[field] is timestamp;
    }

    // Per-game document (board schema 2).
    function validGameShape(gameId, data) {
      return data.keys().hasOnly([
          "id",
          "title",
          "cover",
          "coverIndex",
          "rawgId",
          "rawgSlug",
          "externalSource",
          "platform",
          "genre",
          "year",
          "columnId",
          "position",
          "rating",
          "isFavorite",
          "addedAt",
          "updatedAt",
          "completedAt",
          "migratedAt"
        ]) &&
        data.id == gameId &&
        validString(data.title, 200) &&
        validString(data.columnId, 40) &&
        data.position is number &&
        data.rating is int && data.rating >= 0 && data.rating <= 10 &&
        data.isFavorite is bool &&
        validOptionalString(data, "cover", 1000) &&
        validOptionalInt(data, "coverIndex", 0, 100) &&
        validOptionalString(data, "rawgId", 40) &&
        validOptionalString(data, "rawgSlug", 160) &&
        validOptionalString(data, "externalSource", 40) &&
        validOptionalString(data, "platform", 160) &&
        validOptionalString(data, "genre", 80) &&
        validOptionalString(data, "year", 10) &&
        validOptionalTimestamp(data, "completedAt") &&
        // Set by the schema 1 -> 2 migration so S5's activity trigger can tell
        // a bulk import from something the user just did.
        validOptionalTimestamp(data, "migratedAt") &&
        data.addedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function validGameCreate(gameId, data) {
      return validGameShape(gameId, data) &&
        data.addedAt == request.time;
    }

    function validGameUpdate(gameId, before, after) {
      return validGameShape(gameId, after) &&
        after.addedAt == before.addedAt;
    }

    function validSettings(data) {
      return data.keys().hasOnly(["privacy", "bio", "displayName"]) &&
        (!("privacy" in data) || validPrivacy(data.privacy)) &&
        validOptionalString(data, "bio", 500) &&
        validOptionalString(data, "displayName", 80);
    }

    function validUserDataDoc(docId, data) {
      return (docId == "board" && validBoard(data)) ||
        (docId == "settings" && validSettings(data));
    }

    function validPublicProfile(profileId, data) {
      return data.keys().hasOnly([
          "uid",
          "displayName",
          "displayNameLower",
          "searchTokens",
          "photoURL",
          "privacy",
          "bio"
        ]) &&
        (!("uid" in data) || data.uid == profileId) &&
        ("privacy" in data && validPrivacy(data.privacy)) &&
        validOptionalString(data, "displayName", 80) &&
        validOptionalString(data, "displayNameLower", 80) &&
        (!("searchTokens" in data) || validSearchTokens(data.searchTokens)) &&
        validOptionalString(data, "photoURL", 1000) &&
        validOptionalString(data, "bio", 500);
    }

    function validPlaylistItem(item) {
      return item is map &&
        item.keys().hasOnly([
          "title",
          "platform",
          "genre",
          "year",
          "cover",
          "coverIndex",
          "rating",
          "isFavorite",
          "boardGameId",
          "rawgId",
          "rawgSlug",
          "originId",
          "originRawgId",
          "originRawgSlug",
          "sourceType"
        ]) &&
        validOptionalString(item, "title", 160) &&
        validOptionalString(item, "platform", 160) &&
        validOptionalString(item, "genre", 80) &&
        validOptionalString(item, "year", 10) &&
        validOptionalString(item, "cover", 1200) &&
        validOptionalString(item, "boardGameId", 120) &&
        validOptionalString(item, "rawgId", 40) &&
        validOptionalString(item, "rawgSlug", 160) &&
        validOptionalString(item, "originId", 120) &&
        validOptionalString(item, "originRawgId", 40) &&
        validOptionalString(item, "originRawgSlug", 160) &&
        validOptionalString(item, "sourceType", 40) &&
        validOptionalNumber(item, "coverIndex") &&
        validOptionalNumber(item, "rating") &&
        (!("isFavorite" in item) || item.isFavorite is bool);
    }

    function validPlaylistItems(items) {
      return items is list &&
        items.size() <= 250 &&
        (items.size() == 0 || validPlaylistItem(items[0])) &&
        (items.size() <= 1 || validPlaylistItem(items[items.size() - 1]));
    }

    function validPlaylistCreate(data) {
      return data.keys().hasOnly([
          "title",
          "description",
          "ownerUid",
          "ownerName",
          "privacy",
          "items",
          "createdAt",
          "updatedAt"
        ]) &&
        data.ownerUid == request.auth.uid &&
        validString(data.title, 120) &&
        validOptionalString(data, "description", 1000) &&
        validOptionalString(data, "ownerName", 80) &&
        validPlaylistPrivacy(data.privacy) &&
        validPlaylistItems(data.items) &&
        data.createdAt == request.time &&
        data.updatedAt == request.time;
    }

    function validPlaylistUpdate(before, after) {
      return after.keys().hasOnly([
          "title",
          "description",
          "ownerUid",
          "ownerName",
          "privacy",
          "items",
          "createdAt",
          "updatedAt"
        ]) &&
        before.ownerUid == request.auth.uid &&
        after.ownerUid == before.ownerUid &&
        after.createdAt == before.createdAt &&
        validString(after.title, 120) &&
        validOptionalString(after, "description", 1000) &&
        validOptionalString(after, "ownerName", 80) &&
        validPlaylistPrivacy(after.privacy) &&
        validPlaylistItems(after.items) &&
        after.updatedAt == request.time;
    }

    function validRelationshipType(relationshipType) {
      return relationshipType in ["following", "followers", "requests", "blocked"];
    }

    function validRelationshipBase(data, profileId) {
      return data.uid == profileId &&
        validOptionalString(data, "displayName", 80) &&
        validOptionalString(data, "photoURL", 1000);
    }

    function validFollowing(appId, userId, profileId, data) {
      return userId != profileId &&
        data.keys().hasOnly(["uid", "displayName", "photoURL", "status", "updatedAt"]) &&
        validRelationshipBase(data, profileId) &&
        data.updatedAt == request.time &&
        (
          // The follower writes their own "following" entry.
          (userId == request.auth.uid &&
            hasVisibleProfile(appId, profileId) &&
            !isBlockedBy(appId, profileId) &&
            (
              (data.status == "following" && profilePrivacy(appId, profileId) == "public") ||
              (data.status == "pending" && profilePrivacy(appId, profileId) == "invite_only")
            )) ||
          // The invite-only target accepts: flips the requester's entry from pending to following.
          (profileId == request.auth.uid &&
            (resource == null || resource.data.status == "pending") &&
            data.status == "following" &&
            hasPendingRequestFrom(appId, profileId, userId))
        );
    }

    function validFollowers(appId, userId, profileId, data) {
      return userId != profileId &&
        data.keys().hasOnly(["uid", "displayName", "photoURL", "status", "updatedAt"]) &&
        validRelationshipBase(data, profileId) &&
        data.status == "following" &&
        data.updatedAt == request.time &&
        (
          // A follower adds themselves to a public user's followers list.
          (profileId == request.auth.uid &&
            hasVisibleProfile(appId, userId) &&
            profilePrivacy(appId, userId) == "public" &&
            !isBlockedBy(appId, userId)) ||
          // The list owner accepts a pending request (invite_only).
          (userId == request.auth.uid &&
            hasPendingRequestFrom(appId, userId, profileId))
        );
    }

    function validRequests(appId, userId, profileId, data) {
      return profileId == request.auth.uid &&
        userId != profileId &&
        hasVisibleProfile(appId, userId) &&
        profilePrivacy(appId, userId) == "invite_only" &&
        !isBlockedBy(appId, userId) &&
        data.keys().hasOnly(["uid", "displayName", "photoURL", "status", "createdAt"]) &&
        validRelationshipBase(data, profileId) &&
        data.status == "pending" &&
        data.createdAt == request.time;
    }

    function validBlocked(userId, profileId, data) {
      return userId == request.auth.uid &&
        userId != profileId &&
        data.keys().hasOnly(["uid", "displayName", "photoURL", "blockedAt"]) &&
        validRelationshipBase(data, profileId) &&
        data.blockedAt == request.time;
    }

    function validRelationshipWrite(appId, userId, relationshipType, profileId, data) {
      return validRelationshipType(relationshipType) &&
        (
          (relationshipType == "following" && validFollowing(appId, userId, profileId, data)) ||
          (relationshipType == "followers" && validFollowers(appId, userId, profileId, data)) ||
          (relationshipType == "requests" && validRequests(appId, userId, profileId, data)) ||
          (relationshipType == "blocked" && validBlocked(userId, profileId, data))
        );
    }

    function validRelationshipDelete(userId, relationshipType, profileId) {
      return validRelationshipType(relationshipType) &&
        userId != profileId &&
        (
          ((relationshipType == "following" || relationshipType == "followers") &&
            (userId == request.auth.uid || profileId == request.auth.uid)) ||
          (relationshipType == "requests" &&
            (userId == request.auth.uid || profileId == request.auth.uid)) ||
          (relationshipType == "blocked" && userId == request.auth.uid)
        );
    }

    match /artifacts/{appId} {
      match /users/{userId}/data/{docId} {
        allow read: if isOwner(userId) || (docId == "board" && canViewBoard(appId, userId));
        allow create, update: if isOwner(userId) &&
          validUserDataDoc(docId, request.resource.data);
        allow delete: if isOwner(userId) && docId in ["board", "settings"];
      }

      match /users/{userId}/games/{gameId} {
        allow read: if isOwner(userId) || canViewBoard(appId, userId);
        allow create: if isOwner(userId) &&
          validGameCreate(gameId, request.resource.data);
        allow update: if isOwner(userId) &&
          validGameUpdate(gameId, resource.data, request.resource.data);
        allow delete: if isOwner(userId);
      }

      // Activity events (S5). Written only by the Cloud Functions triggers,
      // which use the admin SDK and bypass rules entirely — clients never
      // write here.
      //
      // Scoped by path, like the games above, and NOT by a recursive
      // `/{path=**}/activity/{eventId}` wildcard reading resource.data: rules
      // are not filters, so a `list` is authorised against the query rather
      // than against each returned document, and a rule the query cannot
      // prove denies the whole query. That makes a follower-scoped collection
      // group query impossible — see the note on S7 in the roadmap.
      match /users/{userId}/activity/{eventId} {
        allow read: if isOwner(userId) || canViewActivity(appId, userId);
        allow write: if false;
      }

      match /public_profiles/{profileId} {
        allow get, list: if isOwner(profileId) ||
          resource.data.privacy in ["public", "invite_only"];
        allow create, update: if isOwner(profileId) &&
          validPublicProfile(profileId, request.resource.data);
        allow delete: if isOwner(profileId);
      }

      match /playlists/{playlistId} {
        allow get, list: if signedIn() &&
          (resource.data.ownerUid == request.auth.uid || resource.data.privacy == "public");
        allow create: if signedIn() &&
          validPlaylistCreate(request.resource.data);
        allow update: if signedIn() &&
          resource.data.ownerUid == request.auth.uid &&
          validPlaylistUpdate(resource.data, request.resource.data);
        allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      }

      match /relationships/{userId}/{relationshipType}/{profileId} {
        allow read: if isOwner(userId) && validRelationshipType(relationshipType);
        allow create, update: if signedIn() &&
          validRelationshipWrite(appId, userId, relationshipType, profileId, request.resource.data);
        allow delete: if signedIn() &&
          validRelationshipDelete(userId, relationshipType, profileId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
